{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "rootDir": "ts/app",
    // "../vendor/…" из ts/app находит static/vendor: так исходники и собранный
    // static/app импортируют одно и то же без символической ссылки (её нет в Windows)
    "rootDirs": ["./ts", "./static"],
    "outDir": "static/app",
    "removeComments": false,
    "newLine": "lf",
    "types": []
  },
  "include": ["ts/app/**/*.ts", "ts/app/**/*.tsx"]
}
