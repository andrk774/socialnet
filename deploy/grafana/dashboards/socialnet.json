{
 "uid": "socialnet-overview",
 "title": "Socialnet — обзор",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "socialnet"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Запросы в секунду по коду",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(socialnet_http_requests_total[5m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p95 время ответа, топ-10 маршрутов",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(socialnet_http_request_duration_seconds_bucket{route!=\"/api/v1/ws\"}[5m]))))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Доля ошибок 5xx",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(socialnet_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(socialnet_http_requests_total[5m])), 1)",
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "WebSocket-соединения",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(socialnet_ws_connections)",
     "legendFormat": "всего"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Пул соединений PostgreSQL",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (state) (socialnet_db_pool_connections)",
     "legendFormat": "{{state}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Очереди",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "socialnet_queue_depth",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "События безопасности в минуту",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 16,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(socialnet_security_events_total[5m])) * 60",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "barchart",
   "title": "Тревоги детектора",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (rule, severity) (increase(socialnet_security_alerts_total[1h]))",
     "legendFormat": "{{rule}} ({{severity}})"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Бизнес-события в минуту",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (event) (rate(socialnet_events_total{event!=\"coins_purchased_amount\"}[5m])) * 60",
     "legendFormat": "{{event}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "stat",
   "title": "С последней удачной копии",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - socialnet_backup{metric=\"last_success_timestamp\"}",
     "legendFormat": "возраст"
    }
   ]
  },
  {
   "id": 11,
   "type": "stat",
   "title": "Проверка восстановлением",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "socialnet_backup{metric=\"last_restore_ok\"}",
     "legendFormat": "ок"
    }
   ]
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Куплено монет за сутки",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(socialnet_events_total{event=\"coins_purchased_amount\"}[24h]))",
     "legendFormat": "монет"
    }
   ]
  },
  {
   "id": 13,
   "type": "stat",
   "title": "QR-коды походов за сутки: сканы, записи, конверсия",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(socialnet_events_total{event=\"qr_scan\"}[24h]))",
     "legendFormat": "сканы",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(increase(socialnet_events_total{event=\"qr_join\"}[24h]))",
     "legendFormat": "записи",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "100 * sum(increase(socialnet_events_total{event=\"qr_join\"}[24h])) / clamp_min(sum(increase(socialnet_events_total{event=\"qr_scan\"}[24h])), 1)",
     "legendFormat": "конверсия, %",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": []
 }
}
