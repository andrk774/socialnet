# Скопируйте в .env и замените значения:  cp .env.example .env
# Сгенерировать секреты:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-at-least-32-bytes-random-hex-string
# Ключ шифрования секретов 2FA (64 hex-символа). Если пусто, выводится
# из JWT_SECRET — но тогда смена JWT_SECRET сломает всем 2FA.
TOTP_ENC_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Для локальной разработки по http:// поставьте false, иначе браузер
# не сохранит refresh-cookie. На сервере с HTTPS — только true.
COOKIE_SECURE=false

# true, только когда перед API стоит ваш Nginx/Caddy.
TRUST_PROXY=false

# Защита от перебора паролей: запросов к /api/v1/auth/* с одного IP.
AUTH_RATE_PER_MIN=10
AUTH_RATE_BURST=20

# Адрес фронтенда: из него строятся ссылки в письмах.
APP_URL=http://localhost:3000
# Домены фронтенда, которым можно открывать WebSocket (через запятую).
# Пусто = только тот же домен, что у API.
ALLOWED_ORIGINS=

# Почта. По умолчанию письма идут в Mailpit (http://127.0.0.1:8025).
# Для настоящей отправки укажите SMTP своего почтового сервиса.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Socialnet <no-reply@localhost>

# Push-уведомления в браузер. Сгенерировать ключи:
#   docker compose run --rm api gen-vapid
# Пусто = push выключен (остальное работает).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Контакт для исследователей безопасности (/.well-known/security.txt).
SECURITY_CONTACT=security@localhost
